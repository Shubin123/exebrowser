.DS_Store
node_modules/
.wrangler/
.dev.vars
assets-too-big-for-pages/
*.log

# Experimental 64-bit (wine64) rootfs + wasm. Too big for GitHub's free LFS
# budget, so these are NOT committed — they live on local disk and wrangler
# uploads them straight to Cloudflare Pages at deploy time. Regenerate from the
# Boxedwine64 build (see public/64/README.md). The small text files (html, js,
# css, manifests) ARE committed.
public/64/*.wasm
public/64/*.zip
public/64/*.part*

# build output of scripts/build-distribution.mjs
dist/

# LibreQuake game data (~78 MB). Not committed: rebuild with
# node scripts/build-librequake-data.mjs (pinned release + sha256).
public/apps/librequake/id1/

# Warzone 2100 4.7.0 web release binaries (~87 MB). Not committed: rebuild with
# node scripts/build-warzone2100-data.mjs (pinned release + sha256). The patched
# glue (warzone2100.js), the parts manifest, the package .js loaders, icons,
# index.html, NOTICE.md and COPYING ARE committed.
public/apps/warzone2100/warzone2100.wasm
public/apps/warzone2100/warzone2100.data.part[0-9]*
public/apps/warzone2100/pkg/*/*.data

# build output of scripts/build-gh-pages.mjs
_site/
